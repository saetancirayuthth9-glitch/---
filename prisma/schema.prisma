generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                   String        @id @default(uuid())
  full_name            String
  student_no           String?
  username             String?       @unique
  password             String?
  role                 String        @default("MEMBER") // "ADMIN" (อาจารย์ที่ปรึกษา), "TREASURER" (เหรัญญิก), "MEMBER" (นักเรียน)
  created_at           DateTime      @default(now())
  
  transactionsCreated  Transaction[] @relation("CreatedBy")
  transactionsPaid     Transaction[] @relation("Payer")

  @@map("users")
}

model Category {
  id           String          @id @default(uuid())
  name         String
  type         String          @default("EXPENSE") // "INCOME" or "EXPENSE"
  
  transactions Transaction[]

  @@map("categories")
}

model Transaction {
  id               String          @id @default(uuid())
  title            String
  amount           Decimal
  type             String          // "INCOME" or "EXPENSE"
  category_id      String
  created_by       String
  payer_id         String?
  receipt_url      String?
  note             String?
  transaction_date DateTime        @default(now())
  created_at       DateTime        @default(now())

  category         Category        @relation(fields: [category_id], references: [id])
  creator          User            @relation("CreatedBy", fields: [created_by], references: [id])
  payer            User?           @relation("Payer", fields: [payer_id], references: [id])

  @@map("transactions")
}
